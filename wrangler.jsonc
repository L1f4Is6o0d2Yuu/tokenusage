{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tokenusage",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "TOKENUSAGE_RUNTIME": "cloudflare",
    "TOKENUSAGE_CLOUDFLARE": "1"
  },
  "d1_databases": [
    {
      "binding": "TOKENUSAGE_DB",
      "database_name": "tokenusage",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "TOKENUSAGE_SHARES",
      "bucket_name": "tokenusage-shares"
    }
  ]
}
