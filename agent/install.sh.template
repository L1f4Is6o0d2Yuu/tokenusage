#!/bin/bash
# tokenusage one-shot installer (curl | sh path).
#
# Downloads the tokenusage CLI to ~/.tokenusage/tokenusage and runs
# `tokenusage start --server … --token …` which writes the config and
# registers the launchd / systemd service.
#
# Re-running this script is safe — it stops any existing agent, rewrites
# the config, and reloads.

set -euo pipefail

SERVER="__SERVER__"
TOKEN="__TOKEN__"

if ! command -v curl >/dev/null; then
  echo "error: curl not found" >&2
  exit 1
fi
if ! command -v tar >/dev/null; then
  echo "error: tar not found" >&2
  exit 1
fi

mkdir -p "$HOME/.tokenusage"
chmod 700 "$HOME/.tokenusage"

curl -fsSL "$SERVER/api/agent-script" -o "$HOME/.tokenusage/tokenusage"
chmod +x "$HOME/.tokenusage/tokenusage"

exec "$HOME/.tokenusage/tokenusage" start --server "$SERVER" --token "$TOKEN"
