#!/bin/bash
# tokenusage one-shot installer (curl | sh path).
#
# Downloads the tokenusage CLI to ~/.tokenusage/tokenusage and runs
# `tokenusage start --server … --token …` which writes the config and
# registers the launchd / systemd service.
#
# Re-running this script is safe — it stops any existing agent, rewrites
# the config, and reloads.

set -euo pipefail

SERVER="__SERVER__"
TOKEN="__TOKEN__"
# Optional. When set, the agent POSTs the tarball here instead of $SERVER.
# Typically a DNS-only sibling of $SERVER (e.g. https://direct.example.com)
# so the upload bypasses any proxy that caps request bodies (Cloudflare
# Free/Pro is 100 MB). The substituting route leaves this blank when the
# server hasn't configured a direct-upload endpoint.
UPLOAD_SERVER="__UPLOAD_SERVER__"

if ! command -v curl >/dev/null; then
  echo "error: curl not found" >&2
  exit 1
fi
if ! command -v tar >/dev/null; then
  echo "error: tar not found" >&2
  exit 1
fi

LABEL="com.tokenusage.agent"
PLIST_PATH="$HOME/Library/LaunchAgents/${LABEL}.plist"
SYSTEMD_UNIT="$HOME/.config/systemd/user/tokenusage-agent.service"

# Hard reset first. This is intentionally more aggressive than `tokenusage start`:
# if a stale launchd/systemd job, old Homebrew symlink, or half-written config is
# wedged, we remove it before installing the fresh script and token.
echo "[tokenusage] cleaning old agent/service state..."
case "$(uname -s)" in
  Darwin)
    launchctl bootout "gui/$(id -u)/${LABEL}" >/dev/null 2>&1 || true
    launchctl remove "${LABEL}" >/dev/null 2>&1 || true
    [ -f "$PLIST_PATH" ] && launchctl unload "$PLIST_PATH" >/dev/null 2>&1 || true
    ;;
  Linux)
    systemctl --user stop tokenusage-agent >/dev/null 2>&1 || true
    systemctl --user disable tokenusage-agent >/dev/null 2>&1 || true
    ;;
esac
pkill -f 'tokenusage.*--loop' >/dev/null 2>&1 || true
rm -f "$PLIST_PATH" "$SYSTEMD_UNIT"
rm -rf "$HOME/.tokenusage"

mkdir -p "$HOME/.tokenusage"
chmod 700 "$HOME/.tokenusage"

curl -fsSL "$SERVER/api/agent-script" -o "$HOME/.tokenusage/tokenusage"
chmod +x "$HOME/.tokenusage/tokenusage"

args=(start --server "$SERVER" --token "$TOKEN")
[ -n "${UPLOAD_SERVER:-}" ] && args+=(--upload-server "$UPLOAD_SERVER")
"$HOME/.tokenusage/tokenusage" "${args[@]}"

# Run a foreground sync once as an immediate smoke test. The background service
# remains installed for future dashboard-triggered syncs; this one-shot makes a
# clean reinstall visibly fail in the terminal if auth/network/config is wrong.
echo "[tokenusage] running immediate foreground sync smoke test..."
"$HOME/.tokenusage/tokenusage" --loop-once || {
  echo "[tokenusage] foreground sync failed. Recent log:" >&2
  tail -n 80 "$HOME/.tokenusage/agent.log" 2>/dev/null >&2 || true
  exit 1
}

echo "[tokenusage] clean reinstall complete."
