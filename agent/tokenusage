#!/bin/bash
# tokenusage — agent CLI for the tokenusage.online dashboard.
#
# Single-file: handles install/uninstall, service registration on
# launchd / systemd, and the long-poll upload loop.
#
# Usage:
#   tokenusage start --server URL --token TOKEN   # first-time install + start
#   tokenusage start                              # restart with saved config
#   tokenusage stop                               # stop the service (keeps config)
#   tokenusage uninstall                          # remove service + config
#   tokenusage status                             # show config + last-upload time
#   tokenusage logs                               # tail the agent log
#   tokenusage sync                               # manual sync now (server flag)
#   tokenusage report [today|7d|30d|all]          # print server aggregate as JSON
#   tokenusage statusline                         # one-line for shell prompts (60s cache)
#   tokenusage doctor                             # local config/network/service diagnostics
#   tokenusage --loop                             # internal: long-poll + upload loop
#   tokenusage version

set -uo pipefail

VERSION="0.27.0"
CONFIG_DIR="$HOME/.tokenusage"
CONFIG_FILE="$CONFIG_DIR/config.env"
STATE_FILE="$CONFIG_DIR/state"
LOG_FILE="$CONFIG_DIR/agent.log"
PLIST_PATH="$HOME/Library/LaunchAgents/com.tokenusage.agent.plist"
SYSTEMD_UNIT="$HOME/.config/systemd/user/tokenusage-agent.service"

ts() { date -u +%FT%TZ; }
err() { printf '%s\n' "$*" >&2; }

# Resolve the absolute path to *this* script so launchd/systemd can be told
# exactly which binary to run. Works for both bin/tokenusage (Homebrew, a
# symlink) and ~/.tokenusage/tokenusage (curl-installed).
script_path() {
  local src="${BASH_SOURCE[0]}"
  while [ -L "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  printf '%s/%s\n' "$(cd -P "$(dirname "$src")" && pwd)" "$(basename "$src")"
}

usage() {
  sed -n '2,17p' "$(script_path)" | sed 's/^# \{0,1\}//'
}

# ---------- service registration ----------

write_launchd_plist() {
  local exe="$1"
  mkdir -p "$(dirname "$PLIST_PATH")"
  cat > "$PLIST_PATH" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tokenusage.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>$exe</string>
    <string>--loop</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>$LOG_FILE</string>
  <key>StandardErrorPath</key><string>$LOG_FILE</string>
  <key>WorkingDirectory</key><string>$HOME</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>$HOME</string>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
PLIST
}

write_systemd_unit() {
  local exe="$1"
  mkdir -p "$(dirname "$SYSTEMD_UNIT")"
  cat > "$SYSTEMD_UNIT" <<UNIT
[Unit]
Description=tokenusage agent
After=network.target

[Service]
ExecStart=$exe --loop
Restart=always
RestartSec=5
StandardOutput=append:$LOG_FILE
StandardError=append:$LOG_FILE

[Install]
WantedBy=default.target
UNIT
}

register_service() {
  local exe
  exe="$(script_path)"
  case "$(uname -s)" in
    Darwin)
      write_launchd_plist "$exe"
      launchctl bootout "gui/$(id -u)/com.tokenusage.agent" >/dev/null 2>&1 || true
      [ -f "$PLIST_PATH" ] && launchctl unload "$PLIST_PATH" 2>/dev/null || true
      launchctl bootstrap "gui/$(id -u)" "$PLIST_PATH" 2>/dev/null || launchctl load "$PLIST_PATH"
      launchctl kickstart -k "gui/$(id -u)/com.tokenusage.agent" >/dev/null 2>&1 || true
      printf '✓ tokenusage agent registered (launchd)\n'
      printf '  Logs:    tail -f %s\n' "$LOG_FILE"
      printf '  Stop:    tokenusage stop\n'
      ;;
    Linux)
      write_systemd_unit "$exe"
      systemctl --user daemon-reload
      systemctl --user enable --now tokenusage-agent
      printf '✓ tokenusage agent registered (systemd --user)\n'
      printf '  Logs:    journalctl --user -u tokenusage-agent -f\n'
      printf '  Stop:    tokenusage stop\n'
      printf '\n  Note: on a headless box, also run\n'
      printf '        sudo loginctl enable-linger $(id -un)\n'
      printf '  so the agent keeps running after you log out.\n'
      ;;
    *)
      err "unsupported OS: $(uname -s) — running in foreground"
      exec "$exe" --loop
      ;;
  esac
}

stop_service() {
  case "$(uname -s)" in
    Darwin)
      launchctl bootout "gui/$(id -u)/com.tokenusage.agent" >/dev/null 2>&1 || true
      [ -f "$PLIST_PATH" ] && launchctl unload "$PLIST_PATH" 2>/dev/null || true
      launchctl remove com.tokenusage.agent >/dev/null 2>&1 || true
      printf '✓ tokenusage agent stopped\n'
      ;;
    Linux)
      systemctl --user stop tokenusage-agent 2>/dev/null || true
      systemctl --user disable tokenusage-agent 2>/dev/null || true
      printf '✓ tokenusage agent stopped\n'
      ;;
    *) ;;
  esac
}


clean_service_state() {
  printf '[%s] cleaning old tokenusage service state...\n' "$(ts)"
  case "$(uname -s)" in
    Darwin)
      launchctl bootout "gui/$(id -u)/com.tokenusage.agent" >/dev/null 2>&1 || true
      [ -f "$PLIST_PATH" ] && launchctl unload "$PLIST_PATH" >/dev/null 2>&1 || true
      launchctl remove com.tokenusage.agent >/dev/null 2>&1 || true
      ;;
    Linux)
      systemctl --user stop tokenusage-agent >/dev/null 2>&1 || true
      systemctl --user disable tokenusage-agent >/dev/null 2>&1 || true
      ;;
  esac
  pkill -f 'tokenusage.*--loop' >/dev/null 2>&1 || true
  rm -f "$PLIST_PATH" "$SYSTEMD_UNIT"
}

print_failure_context() {
  printf '\n[tokenusage] self-check failed. Diagnostics:\n' >&2
  cmd_doctor >&2 || true
  if [ -f "$LOG_FILE" ]; then
    printf '\n[tokenusage] recent upload log:\n' >&2
    tail -n 120 "$LOG_FILE" >&2 || true
  fi
}

# ---------- subcommands ----------

cmd_start() {
  local server="" token="" upload_server=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --server) server="$2"; shift 2 ;;
      --token) token="$2"; shift 2 ;;
      --upload-server) upload_server="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) err "unknown arg: $1"; exit 1 ;;
    esac
  done

  mkdir -p "$CONFIG_DIR"
  chmod 700 "$CONFIG_DIR"

  # One command should fix stale daemons/config drift by default. Preserve an
  # existing config when the user runs plain `tokenusage start`; overwrite it
  # only when a fresh server+token is supplied by the installer/dashboard.
  clean_service_state

  if [ -n "$server" ] && [ -n "$token" ]; then
    {
      printf 'SERVER="%s"\n' "$server"
      printf 'TOKEN="%s"\n' "$token"
      [ -n "$upload_server" ] && printf 'UPLOAD_SERVER="%s"\n' "$upload_server"
    } > "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"
  fi

  if [ ! -f "$CONFIG_FILE" ]; then
    err "no config; run the dashboard install command once, then plain: tokenusage start"
    exit 1
  fi

  # shellcheck disable=SC1090
  . "$CONFIG_FILE"

  printf '[%s] self-checking server/auth...\n' "$(ts)"
  if ! curl -fsS --max-time 15 "$SERVER/api/health" >/dev/null 2>&1; then
    err "server unreachable: $SERVER"
    print_failure_context
    exit 1
  fi
  if ! curl -fsS --max-time 20 "$SERVER/api/sync-wait" \
      -H "Authorization: Bearer $TOKEN" \
      -H "X-Agent-Version: $VERSION" >/dev/null 2>&1; then
    err "auth/sync-wait check failed"
    print_failure_context
    exit 1
  fi

  register_service

  printf '[%s] running immediate upload self-test...\n' "$(ts)"
  : > "$LOG_FILE"
  if ! (LOOP_ONCE=1 cmd_loop 2>&1 | tee -a "$LOG_FILE"); then
    print_failure_context
    exit 1
  fi

  printf '\n✓ tokenusage start complete: service installed, server reachable, upload self-test finished.\n'
  printf '  Logs: tokenusage logs\n'
}

cmd_stop()      { stop_service; }

cmd_uninstall() {
  stop_service
  rm -f "$PLIST_PATH" "$SYSTEMD_UNIT"
  rm -rf "$CONFIG_DIR"
  printf '✓ tokenusage agent uninstalled. Config and logs removed.\n'
}

cmd_status() {
  if [ ! -f "$CONFIG_FILE" ]; then
    printf 'tokenusage: not configured\n'
    return
  fi
  # shellcheck disable=SC1090
  . "$CONFIG_FILE"
  printf 'server:      %s\n' "$SERVER"
  printf 'token:       %s\n' "$(printf '%s' "$TOKEN" | sed 's/\(....\).*\(....\)/\1…\2/')"
  if [ -f "$STATE_FILE" ]; then
    local last
    last=$(cat "$STATE_FILE" 2>/dev/null)
    printf 'last upload: %s\n' "$(date -r "$last" 2>/dev/null || echo "$last")"
  fi
  if [ "$(uname -s)" = "Darwin" ]; then
    if launchctl list 2>/dev/null | grep -q com.tokenusage.agent; then
      printf 'service:     running (launchd)\n'
    else
      printf 'service:     not loaded\n'
    fi
  fi
}

cmd_logs() {
  [ -f "$LOG_FILE" ] || { err "no log yet at $LOG_FILE"; exit 1; }
  exec tail -n 200 -f "$LOG_FILE"
}

cmd_sync() {
  [ -f "$CONFIG_FILE" ] || { err "not configured"; exit 1; }
  # shellcheck disable=SC1090
  . "$CONFIG_FILE"
  curl -fsS -X POST "$SERVER/api/sync-now" \
    -H "Authorization: Bearer $TOKEN" \
    -H "X-Agent-Version: $VERSION" \
    -o /dev/null && printf '✓ sync requested\n'
}

cmd_version() {
  printf 'tokenusage %s\n' "$VERSION"
}

# `tokenusage statusline` — single-line summary for shell prompts.
# Hits the same JSON endpoint as `report`, caches the rendered string
# in ~/.tokenusage/statusline.cache for 60s so prompts (which fire on
# every keystroke under some setups) don't hammer the server.
#
# Designed for starship / oh-my-zsh / p10k right-prompt segments:
#   eval "$(tokenusage statusline 2>/dev/null)"   # noisy on error → silent
cmd_statusline() {
  [ -f "$CONFIG_FILE" ] || exit 0
  local CACHE="$CONFIG_DIR/statusline.cache"
  if [ -f "$CACHE" ]; then
    local mtime
    mtime=$(stat -f%m "$CACHE" 2>/dev/null || stat -c%Y "$CACHE" 2>/dev/null || echo 0)
    if [ -n "$mtime" ] && [ $(( $(date +%s) - mtime )) -lt 60 ]; then
      cat "$CACHE"
      return
    fi
  fi
  # shellcheck disable=SC1090
  . "$CONFIG_FILE"
  local PAYLOAD
  PAYLOAD=$(curl -fsS --max-time 2 \
    "$SERVER/api/export?period=today&format=json" \
    -H "Authorization: Bearer $TOKEN" \
    -H "X-Agent-Version: $VERSION" 2>/dev/null) || exit 0
  local LINE
  if command -v jq >/dev/null 2>&1; then
    LINE=$(printf '%s' "$PAYLOAD" | jq -r '
      "$\((.totals.costUsd * 100 | floor) / 100) · \(
        if .totals.totalTokens >= 1000000 then "\((.totals.totalTokens / 100000 | floor) / 10)M"
        elif .totals.totalTokens >= 1000 then "\((.totals.totalTokens / 100 | floor) / 10)k"
        else "\(.totals.totalTokens)"
        end) tok"')
  else
    LINE="(install jq for statusline)"
  fi
  printf '%s\n' "$LINE" | tee "$CACHE"
}

# `tokenusage report [PERIOD]` — pulls the server's JSON aggregate for
# the requested period and prints a one-screen summary. Default period
# is "today". The output is grep-friendly so it slots into shell
# prompts (\`$(tokenusage report today | head -1)\`) and CI pipelines.
cmd_report() {
  [ -f "$CONFIG_FILE" ] || { err "not configured"; exit 1; }
  # shellcheck disable=SC1090
  . "$CONFIG_FILE"
  local PERIOD="${1:-today}"
  local PAYLOAD
  PAYLOAD=$(curl -fsS "$SERVER/api/export?period=$PERIOD&format=json" \
    -H "Authorization: Bearer $TOKEN" \
    -H "X-Agent-Version: $VERSION" 2>/dev/null) || {
    err "report request failed (check server / token)"; exit 1;
  }
  if command -v jq >/dev/null 2>&1; then
    printf '%s\n' "$PAYLOAD" | jq -r '
      "period:        \(.period)",
      "generated:     \(.generatedAt)",
      "tokens total:  \(.totals.totalTokens)",
      "  input:       \(.totals.inputTokens)",
      "  output:      \(.totals.outputTokens)",
      "  cache_r/w:   \(.totals.cacheReadTokens) / \(.totals.cacheWriteTokens)",
      "cost USD:      \(.totals.costUsd | (. * 10000 | floor) / 10000)",
      "sessions:      \(.totals.records)",
      "top model:     \(.byModel[0].provider // "-")/\(.byModel[0].model // "-")"
    '
  else
    printf '%s\n' "$PAYLOAD"
  fi
}

cmd_doctor() {
  printf 'tokenusage doctor\n'
  printf 'version:      %s\n' "$VERSION"
  printf 'script:       %s\n' "$(script_path)"
  printf 'config:       %s\n' "$CONFIG_FILE"
  if [ ! -f "$CONFIG_FILE" ]; then
    printf 'configured:   no\n'
    return 1
  fi
  # shellcheck disable=SC1090
  . "$CONFIG_FILE"
  printf 'configured:   yes\n'
  printf 'server:       %s\n' "$SERVER"
  if [ -n "${UPLOAD_SERVER:-}" ]; then
    printf 'uploadServer: %s\n' "$UPLOAD_SERVER"
  else
    printf 'uploadServer: (same as server)\n'
  fi
  printf 'token:        %s\n' "$(printf '%s' "$TOKEN" | sed 's/\(....\).*\(....\)/\1…\2/')"
  if [ "$(uname -s)" = "Darwin" ]; then
    if launchctl print "gui/$(id -u)/com.tokenusage.agent" >/dev/null 2>&1; then
      printf 'service:      loaded (launchd)\n'
    else
      printf 'service:      not loaded (launchd)\n'
    fi
  elif command -v systemctl >/dev/null 2>&1; then
    systemctl --user is-active --quiet tokenusage-agent && printf 'service:      active (systemd)\n' || printf 'service:      not active (systemd)\n'
  fi
  printf 'network:      '
  if curl -fsS --max-time 10 "$SERVER/api/health" >/dev/null 2>&1; then
    printf 'server reachable\n'
  else
    printf 'server unreachable\n'
  fi
  printf 'auth:         '
  if curl -fsS --max-time 15 "$SERVER/api/sync-wait" \
    -H "Authorization: Bearer $TOKEN" \
    -H "X-Agent-Version: $VERSION" >/dev/null 2>&1; then
    printf 'ok\n'
  else
    printf 'failed\n'
  fi
  if [ -f "$LOG_FILE" ]; then
    printf '\nlast log lines:\n'
    tail -n 40 "$LOG_FILE"
  fi
}

# ---------- the long-poll loop (--loop) ----------

upload() {
  local TMP SIZE
  TMP="$(mktemp -d -t tokenusage-XXXXXX)"
  trap 'rm -rf "$TMP"' RETURN

  mkdir -p "$TMP/payload"

  # Hermes state.db can grow to multi-GB (route_outcomes, kanban, logs,
  # etc.) and easily blow past the server's 500MB upload cap. We only
  # read the `sessions` table on the server, so slim the file down to
  # just that table before tarring. If sqlite3 isn't available, fall
  # back to copying the raw file only when it's still under a soft cap
  # — past that we'd rather have no hermes data than a failed sync.
  if [ -f "$HOME/.hermes/state.db" ]; then
    if command -v sqlite3 >/dev/null 2>&1; then
      if ! sqlite3 "$HOME/.hermes/state.db" ".dump sessions" 2>/dev/null \
           | sqlite3 "$TMP/payload/hermes.db" 2>/dev/null; then
        rm -f "$TMP/payload/hermes.db"
        printf '[%s] hermes slim failed — skipping (will retry next cycle)\n' "$(ts)"
      fi
    else
      _hsize=$(wc -c < "$HOME/.hermes/state.db" | tr -d ' ')
      if [ "$_hsize" -lt 209715200 ]; then
        cp "$HOME/.hermes/state.db" "$TMP/payload/hermes.db"
      else
        printf '[%s] hermes state.db is %s bytes — install sqlite3 to slim it, skipping\n' "$(ts)" "$_hsize"
      fi
    fi
  fi

  # Codex: legacy `~/.codex` + XDG `~/.config/codex`. Merge both into one
  # codex/ dir so the server-side parser sees a single tree.
  mkdir -p "$TMP/payload/codex"
  for base in "$HOME/.codex" "$HOME/.config/codex"; do
    [ -f "$base/state_5.sqlite" ] && cp "$base/state_5.sqlite" "$TMP/payload/codex/state_5.sqlite"
    [ -d "$base/sessions" ] && cp -Rp "$base/sessions" "$TMP/payload/codex/sessions"
  done
  # Empty? drop the dir to keep the tar slim.
  [ -z "$(ls -A "$TMP/payload/codex" 2>/dev/null)" ] && rmdir "$TMP/payload/codex"

  # Claude Code: legacy `~/.claude/projects` + XDG `~/.config/claude/projects`.
  # Borrowed from hanbu97/tokenusage — some installs put logs under XDG.
  for cand in "$HOME/.claude/projects" "$HOME/.config/claude/projects"; do
    if [ -d "$cand" ]; then
      cp -Rp "$cand" "$TMP/payload/claude-projects"
      break
    fi
  done

  # Cursor / Windsurf — preview support. Collect working dirs so the
  # server has raw data when adapters land. Each capped at 200MB so
  # a chatty Codeium cache can't tank an upload.
  for cursor_dir in "$HOME/.cursor" "$HOME/Library/Application Support/Cursor/User/workspaceStorage"; do
    if [ -d "$cursor_dir" ]; then
      _sz=$(du -sk "$cursor_dir" 2>/dev/null | awk '{print $1}')
      if [ -n "$_sz" ] && [ "$_sz" -lt 204800 ]; then
        mkdir -p "$TMP/payload/cursor"
        cp -Rp "$cursor_dir" "$TMP/payload/cursor/" 2>/dev/null || true
      fi
    fi
  done
  if [ -d "$HOME/.codeium/windsurf" ]; then
    _sz=$(du -sk "$HOME/.codeium/windsurf" 2>/dev/null | awk '{print $1}')
    if [ -n "$_sz" ] && [ "$_sz" -lt 204800 ]; then
      mkdir -p "$TMP/payload/windsurf"
      cp -Rp "$HOME/.codeium/windsurf" "$TMP/payload/windsurf/" 2>/dev/null || true
    fi
  fi

  # JSONL slim — strip lines the server-side parser doesn't read.
  #
  # Claude Code JSONL averages 5% of the original size after this filter:
  # we only need `type: ai-title` for the session title and
  # `type: assistant` for token usage + model. User messages, tool
  # results, system reminders — all dropped.
  #
  # Codex same idea: token_count carries the cumulative usage,
  # turn_context the model, session_meta the session header. Everything
  # else (response_item, agent_message, user_message) is content that
  # the parser ignores.
  #
  # We `touch -r` to preserve the original mtime so the incremental
  # filter below still sees "unchanged" files correctly.
  slim_jsonl_dir() {
    local dir="$1" pattern="$2"
    [ -d "$dir" ] || return 0
    find "$dir" -type f -name '*.jsonl' 2>/dev/null | while IFS= read -r f; do
      grep -E "$pattern" "$f" > "$f.slim" 2>/dev/null
      if [ -s "$f.slim" ]; then
        touch -r "$f" "$f.slim" 2>/dev/null
        mv "$f.slim" "$f"
      else
        rm -f "$f.slim" "$f"
      fi
    done
  }
  slim_jsonl_dir "$TMP/payload/claude-projects" '"type":"(ai-title|assistant)"'
  slim_jsonl_dir "$TMP/payload/codex/sessions"  '"(token_count|turn_context|session_meta)"'

  # Incremental mode: prune big JSONL files that haven't changed since
  # the last successful upload. Control files (hermes.db slim,
  # codex/state_5.sqlite) always stay — the server-side parsers need
  # them to enumerate which sessions exist at all.
  #
  # First upload after install (LAST_UPLOAD=0) sends everything. Same
  # for the eager retry after a 413 — we bumped LAST_UPLOAD on that
  # path so subsequent syncs are incremental.
  INCREMENTAL=0
  if [ "$LAST_UPLOAD" -gt 0 ]; then
    # Build a marker file with mtime exactly $LAST_UPLOAD so find -newer
    # is portable across BSD (macOS) and GNU (Linux) flavors of touch.
    MARKER="$TMP/.mtime-marker"
    case "$(uname -s)" in
      Darwin) touch -t "$(date -r "$LAST_UPLOAD" +%Y%m%d%H%M.%S)" "$MARKER" 2>/dev/null ;;
      *)      touch -d "@$LAST_UPLOAD" "$MARKER" 2>/dev/null ;;
    esac
    if [ -f "$MARKER" ]; then
      # Sweep large JSONLs that haven't changed. Use find ! -newer so
      # the marker file itself (mtime == $LAST_UPLOAD) doesn't get
      # included spuriously.
      for sweep in "$TMP/payload/claude-projects" "$TMP/payload/codex/sessions"; do
        [ -d "$sweep" ] || continue
        find "$sweep" -type f -name '*.jsonl' \! -newer "$MARKER" -delete 2>/dev/null
        # Remove any now-empty subdirs so tar doesn't carry them.
        find "$sweep" -type d -empty -delete 2>/dev/null
      done
      rm -f "$MARKER"
      INCREMENTAL=1
    fi
  fi

  # Even when none of the source dirs exist, send the (empty) tarball
  # anyway. Server-side it costs ~nothing — 0 records insert, 0 bytes
  # written to sessions_data — but `last_uploaded_at` gets updated, so
  # the dashboard's "last synced" stamp reflects the actual cycle the
  # agent ran. Without this, a user who never touched Claude/Codex/
  # Hermes would see "never synced" forever, even after a manual sync.
  if [ -z "$(ls -A "$TMP/payload" 2>/dev/null)" ]; then
    printf '[%s] no local data (none of ~/.hermes ~/.codex ~/.claude/projects exist) — sending empty sync\n' "$(ts)"
  fi

  tar czf "$TMP/payload.tar.gz" -C "$TMP/payload" .
  SIZE=$(wc -c < "$TMP/payload.tar.gz" | tr -d ' ')

  # Tell the server the tarball size before we start streaming the
  # body. The dashboard reads this from /api/sync-status so it can show
  # a real "uploading X MB · 1m 30s elapsed" indicator for the first
  # sync (which can take minutes for a 300+ MB raw payload). Failures
  # here are non-fatal — we still attempt the upload.
  curl -sS --max-time 10 \
    -X POST "$SERVER/api/upload-progress" \
    -H "Authorization: Bearer $TOKEN" -H "X-Agent-Version: $VERSION" \
    -H "Content-Type: application/json" \
    --data "{\"totalBytes\":$SIZE}" \
    -o /dev/null 2>/dev/null || true

  # Cloudflare Free/Pro caps request bodies at 100 MB at the edge.
  # If UPLOAD_SERVER is set in config.env (typically a "DNS only"
  # sibling of $SERVER like https://direct.tokenusage.online), the
  # tarball POST bypasses CF and lands directly on the origin Caddy,
  # which allows up to 500 MB. Everything else (sync-wait long-poll,
  # sync-now, export) still uses $SERVER and benefits from CF.
  UPLOAD_URL="${UPLOAD_SERVER:-$SERVER}/api/upload"
  INCR_HEADER="X-Incremental: $INCREMENTAL"
  HTTP_CODE=$(curl -sS --max-time 600 \
    -X POST "$UPLOAD_URL" \
    -H "Authorization: Bearer $TOKEN" -H "X-Agent-Version: $VERSION" \
    -H "Content-Type: application/gzip" \
    -H "$INCR_HEADER" \
    --data-binary "@$TMP/payload.tar.gz" \
    -o /dev/null -w '%{http_code}' 2>/dev/null) || HTTP_CODE=000

  case "$HTTP_CODE" in
    2*)
      LAST_UPLOAD=$(date +%s)
      printf '%s' "$LAST_UPLOAD" > "$STATE_FILE"
      printf '[%s] upload OK (%s bytes, %s)\n' "$(ts)" "$SIZE" \
        "$([ "$INCREMENTAL" = "1" ] && echo "incremental" || echo "full")"
      return 0
      ;;
    503)
      # Server is busy (disk full / locked). The outer loop retries every
      # 5 min anyway, so just log and move on — no exit, no state bump.
      printf '[%s] upload 503 (server busy) — will retry next cycle\n' "$(ts)"
      return 1
      ;;
    413)
      # Body too large at the edge (likely Cloudflare's 100 MB cap).
      # Bump LAST_UPLOAD so the retry storm subsides: the user will
      # see a stale "last synced" stamp and notice, instead of the
      # agent thrashing every 90s. They should set UPLOAD_SERVER in
      # ~/.tokenusage/config.env to a DNS-only origin endpoint.
      LAST_UPLOAD=$(date +%s)
      printf '%s' "$LAST_UPLOAD" > "$STATE_FILE"
      printf '[%s] upload 413 — payload exceeds proxy limit. Set UPLOAD_SERVER in %s to a DNS-only origin endpoint (e.g. https://direct.your.domain).\n' "$(ts)" "$CONFIG_FILE"
      return 1
      ;;
    *)
      printf '[%s] upload FAILED (HTTP %s)\n' "$(ts)" "$HTTP_CODE"
      return 1
      ;;
  esac

  rm -rf "$TMP"
}

cmd_loop() {
  [ -f "$CONFIG_FILE" ] || { err "not configured"; exit 1; }
  # shellcheck disable=SC1090
  . "$CONFIG_FILE"

  if [ -f "$STATE_FILE" ]; then
    LAST_UPLOAD=$(cat "$STATE_FILE" 2>/dev/null || echo 0)
  else
    LAST_UPLOAD=0
  fi
  INTERVAL_SECONDS=300

  printf '[%s] tokenusage agent starting; server=%s\n' "$(ts)" "$SERVER"

  if [ "${LOOP_ONCE:-0}" = "1" ]; then
    upload
    return
  fi

  # Eager first upload unless we just uploaded (rapid restart loop guard).
  NOW=$(date +%s)
  if [ $((NOW - LAST_UPLOAD)) -gt 60 ]; then
    upload
  fi

  while true; do
    RESP=$(curl -fsS --max-time 360 \
      "$SERVER/api/sync-wait" \
      -H "Authorization: Bearer $TOKEN" \
      -H "X-Agent-Version: $VERSION" 2>/dev/null || echo '')

    NEW_INTERVAL=$(printf '%s' "$RESP" | sed -nE 's/.*"intervalSeconds":([0-9]+).*/\1/p')
    [ -n "$NEW_INTERVAL" ] && INTERVAL_SECONDS=$NEW_INTERVAL

    # Server-advertised upload endpoint. Overrides any local UPLOAD_SERVER
    # set in config.env — lets the server roll out an off-CF upload host
    # to existing agents without anyone editing files. Empty / absent
    # means "use whatever you had before" (UPLOAD_SERVER → SERVER).
    SERVER_UPLOAD=$(printf '%s' "$RESP" | sed -nE 's/.*"uploadServer":"([^"]+)".*/\1/p')
    [ -n "$SERVER_UPLOAD" ] && UPLOAD_SERVER="$SERVER_UPLOAD"

    PAUSED=$(printf '%s' "$RESP" | sed -nE 's/.*"paused":(true|false).*/\1/p')
    SYNC=$(printf '%s' "$RESP" | sed -nE 's/.*"sync":(true|false).*/\1/p')
    NOW=$(date +%s)
    ELAPSED=$((NOW - LAST_UPLOAD))

    # Pull-based sync: only upload when the server explicitly asks via
    # SYNC=true (the dashboard auto-fires /api/sync-now when a user
    # opens or refreshes a page). The old "every $INTERVAL_SECONDS
    # regardless of viewer activity" branch is gone — agents on idle
    # machines whose owner isn't looking now stay silent instead of
    # burning bandwidth into a void. ELAPSED / INTERVAL_SECONDS still
    # come back from the server so this is a single-version change to
    # flip back if needed.
    if [ "$PAUSED" = "true" ]; then
      printf '[%s] tracking paused — skipping upload\n' "$(ts)"
    elif [ "$SYNC" = "true" ]; then
      upload
    fi

    sleep 1
  done
}

# ---------- dispatch ----------

case "${1:-help}" in
  start)     shift; cmd_start "$@" ;;
  stop)      shift; cmd_stop "$@" ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  status)    shift; cmd_status "$@" ;;
  logs)      shift; cmd_logs "$@" ;;
  sync)      shift; cmd_sync "$@" ;;
  report)    shift; cmd_report "$@" ;;
  statusline) shift; cmd_statusline "$@" ;;
  doctor)    shift; cmd_doctor "$@" ;;
  --loop)    cmd_loop ;;
  --loop-once) LOOP_ONCE=1 cmd_loop ;;
  version|--version|-v) cmd_version ;;
  help|--help|-h) usage ;;
  *) err "unknown command: $1"; usage; exit 1 ;;
esac
