{
  "$schema": "Edit data/prices.json (in this same dir) to override these defaults. All numbers are USD per single token.",
  "version": 1,
  "rules": [
    {
      "match": "^gpt-5\\.5",
      "input": 0.000005,
      "output": 0.00003,
      "cacheRead": 5e-7
    },
    {
      "match": "^gpt-5\\.4",
      "input": 0.0000025,
      "output": 0.000015,
      "cacheRead": 2.5e-7
    },
    {
      "match": "^gpt-5",
      "input": 0.00000125,
      "output": 0.00001,
      "cacheRead": 1.25e-7
    },
    {
      "match": "^o4-mini",
      "input": 0.0000011,
      "output": 0.0000044,
      "cacheRead": 2.75e-7
    },
    {
      "match": "^o4",
      "input": 0.000005,
      "output": 0.00002,
      "cacheRead": 0.00000125
    },
    {
      "match": "opus",
      "input": 0.000005,
      "output": 0.000025,
      "cacheRead": 5e-7,
      "cacheWrite": 0.00000625
    },
    {
      "match": "sonnet",
      "input": 0.000003,
      "output": 0.000015,
      "cacheRead": 3e-7,
      "cacheWrite": 0.00000375
    },
    {
      "match": "haiku",
      "input": 0.000001,
      "output": 0.000005,
      "cacheRead": 1.0000000000000001e-7,
      "cacheWrite": 0.00000125
    },
    {
      "match": "deepseek-reasoner",
      "input": 7e-7,
      "output": 0.0000025,
      "cacheRead": 2.8e-9
    },
    {
      "match": "deepseek",
      "input": 3.2e-7,
      "output": 8.9e-7,
      "cacheRead": 2.8e-9
    },
    {
      "match": "gemini.*pro",
      "input": 0.00000125,
      "output": 0.00001,
      "cacheRead": 1.25e-7,
      "cacheWrite": 3.75e-7
    }
  ]
}
