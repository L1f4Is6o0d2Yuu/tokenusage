{
  "$schema": "Edit data/prices.json (in this same dir) to override these defaults. All numbers are USD per single token.",
  "version": 1,
  "rules": [
    {
      "match": "^gpt-5\\.5",
      "input": 0.000005,
      "output": 0.00003,
      "cacheRead": 5e-7
    },
    {
      "match": "^gpt-5\\.4",
      "input": 0.0000025,
      "output": 0.000015,
      "cacheRead": 2.5e-7
    },
    {
      "match": "^gpt-5",
      "input": 0.00000125,
      "output": 0.00001,
      "cacheRead": 1.25e-7
    },
    {
      "match": "^o4-mini",
      "input": 0.0000011,
      "output": 0.0000044,
      "cacheRead": 2.75e-7
    },
    {
      "match": "^o4",
      "input": 0.000005,
      "output": 0.00002,
      "cacheRead": 0.00000125
    },
    {
      "match": "opus",
      "input": 0.000005,
      "output": 0.000025,
      "cacheRead": 5e-7,
      "cacheWrite": 0.00000625
    },
    {
      "match": "sonnet",
      "input": 0.000003,
      "output": 0.000015,
      "cacheRead": 3e-7,
      "cacheWrite": 0.00000375
    },
    {
      "match": "haiku",
      "input": 0.000001,
      "output": 0.000005,
      "cacheRead": 1.0000000000000001e-7,
      "cacheWrite": 0.00000125
    },
    {
      "match": "deepseek-reasoner",
      "input": 7e-7,
      "output": 0.0000025,
      "cacheRead": 2.8e-9
    },
    {
      "match": "deepseek-coder",
      "input": 2.52e-7,
      "output": 3.78e-7,
      "cacheRead": 2.52e-8
    },
    {
      "match": "deepseek",
      "input": 3.2e-7,
      "output": 8.9e-7,
      "cacheRead": 2.8e-9
    },
    {
      "match": "gemini.*pro",
      "input": 0.00000125,
      "output": 0.00001,
      "cacheRead": 1.25e-7,
      "cacheWrite": 3.75e-7
    },
    {
      "match": "gemini.*flash",
      "input": 3e-7,
      "output": 0.0000025,
      "cacheRead": 3e-8,
      "cacheWrite": 8.333333333333334e-8
    },
    {
      "match": "^(xiaomi[/-])?mimo-flash",
      "input": 1e-7,
      "output": 3e-7,
      "cacheRead": 1e-8
    },
    {
      "match": "^(xiaomi[/-])?mimo",
      "input": 0.000001,
      "output": 0.000003,
      "cacheRead": 2e-7
    },
    {
      "match": "qwen.*coder",
      "input": 6.5e-7,
      "output": 0.00000325,
      "cacheRead": 1.3e-7,
      "cacheWrite": 8.125e-7
    },
    {
      "match": "qwen.*max",
      "input": 7.8e-7,
      "output": 0.0000039
    },
    {
      "match": "qwen.*plus",
      "input": 4e-7,
      "output": 0.0000024
    },
    {
      "match": "qwen.*flash",
      "input": 2.5e-7,
      "output": 0.0000015,
      "cacheWrite": 3.125e-7
    },
    {
      "match": "qwen",
      "input": 2.5e-7,
      "output": 0.0000015,
      "cacheWrite": 3.125e-7
    },
    {
      "match": "^(moonshot[/-])?kimi",
      "input": 7.5e-7,
      "output": 0.0000035,
      "cacheRead": 1.5e-7
    },
    {
      "match": "^glm|zhipu",
      "input": 9.8e-7,
      "output": 0.00000308,
      "cacheRead": 1.82e-7
    },
    {
      "match": "minimax",
      "input": 2.99e-7,
      "output": 0.0000012
    },
    {
      "match": "ernie|wenxin",
      "input": 7e-8,
      "output": 2.8e-7
    },
    {
      "match": "hunyuan|^tencent",
      "input": 6.6e-8,
      "output": 2.6e-7,
      "cacheRead": 2.9e-8
    },
    {
      "match": "^step|stepfun",
      "input": 1e-7,
      "output": 3e-7
    }
  ]
}
