# Copy to .env and edit. docker-compose reads it automatically.

# The public domain you've pointed at this server (A/AAAA record). Caddy
# uses it to provision a Let's Encrypt cert. For local testing without DNS:
# TOKENUSAGE_DOMAIN=localhost
TOKENUSAGE_DOMAIN=tokenusage.example.com

# Optional dev-stack domain. Caddy adds a second site block routing this
# to the `app-dev` upstream. Leave unset (or `dev.localhost`) if you're
# not running the dev compose project.
# TOKENUSAGE_DEV_DOMAIN=dev.tokenusage.example.com

# Optional "direct" upload endpoint. Same prod app upstream as
# TOKENUSAGE_DOMAIN, but the agent uses this hostname for /api/upload
# when the regular domain sits behind Cloudflare (which caps request
# bodies at 100 MB on Free/Pro plans). Point this A record at the
# origin as "DNS only" — not proxied — so CF doesn't intercept.
# TOKENUSAGE_DIRECT_DOMAIN=direct.tokenusage.example.com

# Cloudflare API token used for Let's Encrypt DNS-01 challenge. Required
# when domains are behind Cloudflare's orange-cloud proxy (HTTP-01 would
# fail because LE hits Cloudflare's edge instead of the origin). Create
# at https://dash.cloudflare.com/profile/api-tokens with the "Edit zone
# DNS" template, scoped to your zone only.
# CLOUDFLARE_API_TOKEN=cfut_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Sign-In (optional). When both are set, /login shows a "Sign in
# with Google" button. Sign-in is restricted to email addresses that
# already match an existing account — new users still need an invite
# link first, and can sign in via Google afterwards using the same
# email. Create a Web Application OAuth client at
# https://console.cloud.google.com/apis/credentials with
# "Authorized redirect URI" set to:
#     https://${TOKENUSAGE_DOMAIN}/auth/oauth/google/callback
# (and the dev callback if you run the dev stack).
# GOOGLE_OAUTH_CLIENT_ID=...
# GOOGLE_OAUTH_CLIENT_SECRET=...

# Optional Telegram business alerts for server-side upload/ingest failures.
# These use the same variable names as ops/notify.sh. Keep real values only
# in your private .env or /etc/tokenusage-notify.env, never in git.
# TG_BOT_TOKEN=123456:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TG_CHAT_ID=-1001234567890
