# Reverse-proxy + automatic HTTPS for tokenusage.
# {$TOKENUSAGE_DOMAIN} comes from docker-compose's environment.

(common) {
	encode gzip
	# Tighten a couple of headers. The dashboard doesn't load third-party
	# scripts so a strict CSP is safe; Server Actions still work because
	# they POST to the same origin.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
	}
	log {
		output stdout
		format console
	}
	# DNS-01 ACME challenge via Cloudflare. Works regardless of whether
	# the zone is behind Cloudflare's orange-cloud proxy. Requires the
	# caddy-dns/cloudflare plugin (baked into ./caddy/Dockerfile) and
	# CLOUDFLARE_API_TOKEN in the environment.
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
}

{$TOKENUSAGE_DOMAIN} {
	reverse_proxy app:3000
	import common
}

# Dev stack — only reachable when the dev compose project is up, which
# attaches an `app-dev` alias to the shared `tokenusage_edge` network.
# Until then this site 502s, which is fine for staging URLs.
{$TOKENUSAGE_DEV_DOMAIN} {
	reverse_proxy app-dev:3000
	import common
}
