{
  "name": "tokenusage",
  "version": "0.28.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --import ./tests/register-hooks.mjs --test tests/*.test.mjs",
    "sample": "node scripts/generate-sample.mjs",
    "agent": "node agent/index.mjs",
    "ops:agent-health": "node ops/agent-health-report.mjs",
    "refresh-prices": "node scripts/refresh-prices.mjs",
    "cf:build": "TOKENUSAGE_CLOUDFLARE=1 opennextjs-cloudflare build",
    "cf:preview": "TOKENUSAGE_CLOUDFLARE=1 opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "TOKENUSAGE_CLOUDFLARE=1 opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "html-to-image": "^1.11.13",
    "lenis": "^1.3.23",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.95.0"
  }
}
